# Visual Intent Agent 配置模板（v1.0.0rc1 候选交付；本轮仅静态整理，未测试/未验证）
#
# 用法：复制为仓库根目录的 .env 后填写。
#   cp .env.example .env
# 真实模式（默认模式，即不带 --demo）至少需要 VIA_PROVIDER_BASE_URL 与
# VIA_PROVIDER_API_KEY；--demo 离线演示完全不读取本文件。
#
# 优先级：进程环境变量 > 仓库根 .env > visual_intent_agent/config.py 的 Settings 字段默认值。
# .env 支持 # 注释行、可选的 "export " 前缀与可选单/双引号。
# 变量名唯一来源：visual_intent_agent/config.py 的 ENV_VAR_NAMES。
#
# 本文件只是模板，不含任何真实凭据；填写后的 .env 已被 .gitignore 忽略，不要提交到版本库。

# ---------------------------------------------------------------------------
# Provider 连接（必填，请填写真实值；本模板留空）
# VIA_PROVIDER_BASE_URL 为空或非 http(s) 时，真实模式在启动时报配置错误并退出（退出码 2）；
# VIA_PROVIDER_API_KEY 为空虽能通过配置校验，但真实调用会失败。
# ---------------------------------------------------------------------------

# Provider endpoint，必须以 http:// 或 https:// 开头。
VIA_PROVIDER_BASE_URL=

# Provider 凭据；只以 pydantic.SecretStr 持有，不会被 CLI/日志打印。
VIA_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# 模型（可选；注释掉即使用 Settings 字段默认值）
# 下面写出的默认值只是当前 Settings 的字段默认，不是已核实的官方模型版本声明。
# ---------------------------------------------------------------------------

#VIA_LLM_MODEL=qwen3.8-max
#VIA_IMAGE_MODEL=qwen-image-3.0

# ---------------------------------------------------------------------------
# 超时与传输层重试（可选）
# ---------------------------------------------------------------------------

# 语言模型单次调用超时（秒），默认 60.0。
#VIA_LLM_TIMEOUT_SECONDS=60.0

# 图片模型单次调用超时（秒），默认 120.0。
#VIA_IMAGE_TIMEOUT_SECONDS=120.0

# Provider 适配器 HTTP 重试上限（指数退避 0.5s × 2^n），默认 2。
# 只影响单次调用内部的传输重试；不会自动重试生成/确认/反馈流程。
#VIA_HTTP_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# 本地数据位置（可选）
# 默认值由仓库根目录推导；显式相对路径按当前工作目录解析，建议在仓库根运行。
# ---------------------------------------------------------------------------

# 业务 SQLite 数据库路径，默认 data/visual_intent.db。
# 注意：--demo 的默认库不同，为 data/cli_demo.db。
#VIA_DB_PATH=data/visual_intent.db

# 生成图片输出目录，默认 outputs/generations（--demo 与真实模式默认相同）。
#VIA_OUTPUT_DIR=outputs/generations
